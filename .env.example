# Copy this file to ".env" and fill in your own values.
# .env is ignored by git, so your token never goes to GitHub.
#
# Airtable personal access token — create it at https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write
# Access: the base "HR Recruiting – Micro Medical Devices" only
AIRTABLE_TOKEN=paste-your-token-here

# Base "HR Recruiting – Micro Medical Devices" (not a secret)
AIRTABLE_BASE_ID=appZ97rL7uoJsaHWn
AIRTABLE_TABLE=CVs
